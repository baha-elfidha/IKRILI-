# Copie ce fichier en ".env" pour le développement local
SECRET_KEY=une-longue-chaine-aleatoire
# Sans DATABASE_URL, l'application utilise un fichier SQLite local (ikrili.db)
# DATABASE_URL=postgresql://ikrili:motdepasse@localhost:5432/ikrili

# Stockage des photos sur Cloudinary (obligatoire en production)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Envoi d'e-mails (Brevo, SMTP) : mot de passe oublié et vérification de l'e-mail
# Sans ces deux variables, aucun e-mail ne part et la vérification n'est pas exigée.
# MAIL_USERNAME=identifiant-smtp@smtp-brevo.com
# MAIL_PASSWORD=cle-smtp-brevo
# MAIL_FROM=IKRILI <contact@ikrili.tn>
